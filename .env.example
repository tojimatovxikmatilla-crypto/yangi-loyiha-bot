# @BotFather'dan olingan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI yordamchi funksiyalari uchun (hozircha bo'sh qoldiring, keyinroq qo'shiladi)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Ixtiyoriy sozlamalar
MAX_DOWNLOAD_SIZE_MB=50
DOWNLOAD_DIR=downloads

# Admin panelga kira oladigan Telegram user ID (vergul bilan bir nechtasi)
# O'z ID'ingizni bilish uchun Telegram'da @userinfobot ga /start bosing
ADMIN_IDS=123456789
